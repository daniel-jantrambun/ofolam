{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "ofolam",
  "main": "./worker/index.ts",
  "compatibility_date": "2026-09-01",
  "assets": {
    "not_found_handling": "single-page-application",
    // The API takes precedence over static assets
    "run_worker_first": ["/api/*"]
  },
  // Cache of Strava responses (activities). Create with: pnpm wrangler kv namespace create CACHE
  "kv_namespaces": [
    {
      "binding": "CACHE",
      "id": "712c90cee85545d98ad581cf6dac81e6"
    }
  ],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "ofolam",
      "database_id": "985df16d-9df8-4525-ac66-fefe70454164"
    }
  ],
  // Production Strava app (callback domain = your domain). For local dev, .dev.vars
  // overrides STRAVA_CLIENT_ID with the "dev" app (callback domain = localhost).
  "vars": {
    "STRAVA_CLIENT_ID": "282591"
  },
  // Nightly cleanup of sessions idle for 90 days and of athletes without a session (worker/cleanup.ts)
  "triggers": { "crons": ["30 3 * * *"] },
  "routes": [{ "pattern": "ofolam.com", "custom_domain": true }]
  // Secrets (wrangler secret put / .dev.vars): STRAVA_CLIENT_SECRET, TOKEN_KEY
}
