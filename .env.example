# Map background (optional). Raster tile URL templates with {z}/{x}/{y}.
# Default: Stadia Maps (free, no key on localhost; register your domain on stadiamaps.com in production).
# MapTiler alternative (free key):
#   VITE_TILES_LIGHT=https://api.maptiler.com/maps/dataviz/256/{z}/{x}/{y}@2x.png?key=TA_CLE
#   VITE_TILES_DARK=https://api.maptiler.com/maps/dataviz-dark/256/{z}/{x}/{y}@2x.png?key=TA_CLE
#   VITE_TILES_ATTRIBUTION=© MapTiler © OpenStreetMap contributors
VITE_TILES_LIGHT=
VITE_TILES_DARK=
VITE_TILES_ATTRIBUTION=

# "Buy me a coffee" link (optional). Missing = the link is not shown.
VITE_COFFEE_URL=

# Legal pages (publisher identity shown in the privacy policy, terms and legal notice)
VITE_LEGAL_NAME=
VITE_CONTACT_EMAIL=

# Set to "true" so the "Powered by Strava" logo and the credit can be dragged on the preview:
# they don't only move through the corner picker. Missing = they can not be dragged freely.
VITE_NO_LOCK_MENTIONS=
